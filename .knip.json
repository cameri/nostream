{
    "$schema": "https://unpkg.com/knip@2/schema.json",
    "workspaces": {
        ".": {
            "entry": [
                "src/index.ts!",
                "src/import-events.ts!",
                "src/cli/index.ts!",
                "src/scripts/benchmark-queries.ts!",
                "knexfile.js!"
            ],
            "project": [
                "src/**/*.ts!"
            ],
            "ignoreDependencies": [
                "lzma-native"
            ],
            "ignore": [
                ".nostr/**",
                "src/utils/negentropy.ts",
                "src/utils/relay-probe/**"
            ],
            "commitlint": false,
            "eslint": false,
            "github-actions": false,
            "husky": false,
            "mocha": false,
            "nyc": false,
            "semantic-release": false
        },
        "website/site": {
            "entry": [
                "astro.config.mjs",
                "src/**/*.{astro,ts,mjs}",
                "scripts/*.mjs"
            ],
            "ignoreDependencies": [
                "@fontsource-variable/inter",
                "@fontsource/jetbrains-mono",
                "astro",
                "sharp",
                "wrangler"
            ],
            "astro": true
        }
    }
}