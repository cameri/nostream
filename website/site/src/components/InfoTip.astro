---
// Inline "(i)" affordance: the visible copy stays user-facing; the technical
// detail lives in a hover/focus/tap tooltip. Progressively enhanced — works
// without JS for hover and keyboard; the tap-open state uses the native
// <details> behavior so touch gets a reliable open/close with no scripts.
interface Props {
  /** The technical detail shown inside the tooltip. */
  detail: string
  /** Accessible name for the toggle, e.g. "rate limiting". */
  label?: string
}
const { detail, label = 'more detail' } = Astro.props
const id = `tip-${Astro.props['detail'] ? '' : ''}${Math.random().toString(36).slice(2, 10)}`
---

<details class="info-tip">
  <summary
    class="info-dot mono"
    aria-label={`Technical detail: ${label}`}
    aria-expanded="false"
    aria-controls={id}
  >i</summary>
  <span class="tip-bubble" role="tooltip" id={id}>{detail}</span>
</details>

<style>
  .info-tip {
    position: relative;
    display: inline-block;
    margin-left: 0.35em;
  }
  .info-tip > summary {
    list-style: none;
  }
  .info-tip > summary::-webkit-details-marker {
    display: none;
  }
  .info-dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 16px;
    height: 16px;
    border-radius: 999px;
    border: 1px solid var(--panel-border);
    background: transparent;
    color: var(--fg-2);
    font-size: 10px;
    font-style: italic;
    font-weight: 700;
    line-height: 1;
    cursor: help;
    padding: 0;
    vertical-align: super;
  }
  .info-dot:hover,
  .info-tip[open] .info-dot,
  .info-dot:focus-visible {
    border-color: var(--teal);
    color: var(--teal);
  }
  .tip-bubble {
    position: absolute;
    bottom: calc(100% + 4px);
    left: 50%;
    transform: translateX(-50%);
    width: max-content;
    max-width: min(260px, calc(100vw - 32px));
    padding: 8px 10px;
    border: 1px solid var(--panel-border);
    border-radius: 8px;
    background: var(--panel);
    color: var(--fg);
    font-size: 12.5px;
    line-height: 1.45;
    text-align: left;
    white-space: normal;
    z-index: 30;
    /* Closed by default; the gap between button and bubble is bridged by a
       transparent ::after on the OPEN state only, so the bubble can receive
       pointer events while open and never intercepts clicks when closed. */
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.35);
  }
  /* Hover open (desktop): pointer on the toggle or on the open bubble keeps
     it visible. Tap open (touch/keyboard): the <details> open state. */
  .info-tip:hover .tip-bubble,
  .info-tip[open] .tip-bubble {
    opacity: 1;
    pointer-events: auto;
  }
  .info-tip[open] .tip-bubble::after {
    /* Bridge the 4px gap so moving the pointer from button to bubble does
       not close it (open-state hover chain). */
    content: '';
    position: absolute;
    left: 50%;
    bottom: -6px;
    width: 60%;
    height: 6px;
    transform: translateX(-50%);
  }
  /* Hover-open without JS on a *closed* details: the native open state also
     fires on click; JS-free close happens on outside click via the document
     handler below. */
</style>

<script>
  // All behavior is DELEGATED at the document level: per-element listeners
  // proved fragile (one tip ended up unhooked in a real-browser trace, with
  // no error and no way to see it from markup). Delegation covers every
  // current and future .info-tip regardless of node replacement.
  const closeAll = (except?: Element | null) => {
    document.querySelectorAll('details.info-tip[open]').forEach((d) => {
      if (d !== except) d.removeAttribute('open')
    })
  }
  // Keep aria-expanded truthful and clamp the bubble inside the viewport.
  // The bubble is centered on its (i) toggle by the stylesheet's
  // translateX(-50%); near a viewport edge the centered box overflows and
  // clips (CSS max-width bounds the width, not the position).
  const clamp = (details: Element) => {
    const bubble = details.querySelector<HTMLElement>('.tip-bubble')
    if (!bubble) return
    // Clear only any PREVIOUS inline shift; the stylesheet's own
    // translateX(-50%) stays applied, so the measured rect IS the rendered
    // (centered) box — no half-width arithmetic.
    bubble.style.transform = ''
    const pad = 12
    const rect = bubble.getBoundingClientRect()
    const overshootLeft = pad - rect.left
    const overshootRight = rect.right - (window.innerWidth - pad)
    if (overshootLeft > 0) {
      bubble.style.transform = `translateX(-50%) translateX(${overshootLeft}px)`
    } else if (overshootRight > 0) {
      bubble.style.transform = `translateX(-50%) translateX(${-overshootRight}px)`
    }
  }
  // toggle does not bubble; capture at the document sees every details.
  document.addEventListener(
    'toggle',
    (e) => {
      const d = (e.target as Element | null)?.closest?.('details.info-tip')
      if (!d) return
      d.querySelector('summary')?.setAttribute('aria-expanded', d.hasAttribute('open') ? 'true' : 'false')
      if (d.hasAttribute('open')) {
        // Measure after layout so getBoundingClientRect sees the real rect.
        requestAnimationFrame(() => clamp(d))
      } else if (d.matches(':hover')) {
        // Tap-close while the pointer stays over the tooltip: :hover keeps
        // the bubble visible, so re-clamp instead of clearing the shift.
        clamp(d)
      } else {
        const bubble = d.querySelector<HTMLElement>('.tip-bubble')
        if (bubble) bubble.style.transform = ''
      }
    },
    true,
  )
  // Hover path: the bubble opens via CSS without a toggle event. pointerenter
  // does not bubble either — use pointerover delegation on the toggle/summary.
  document.addEventListener('pointerover', (e) => {
    const d = (e.target as Element | null)?.closest?.('details.info-tip')
    if (d) clamp(d)
  })
  document.addEventListener('click', (e) => {
    const tip = (e.target as Element | null)?.closest?.('details.info-tip')
    closeAll(tip)
  })
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAll(null)
  })
  // Re-clamp when the viewport moves under a visible bubble (rotation,
  // resize) — hover-opened bubbles have no [open], so match both.
  window.addEventListener('resize', () => {
    document.querySelectorAll('details.info-tip[open], details.info-tip:hover').forEach(clamp)
  }, { passive: true })
</script>
