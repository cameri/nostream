---
import Logo from './Logo.astro'
import { NAV, REPO, VERSION } from '../data/site'

// Astro.url.pathname carries the configured base (preview deploys), so strip
// it before comparing against the base-relative NAV hrefs.
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const current = base && (Astro.url.pathname.replace(/\/$/, '') || '/').startsWith(base)
  ? (Astro.url.pathname.replace(/\/$/, '') || '/').slice(base.length) || '/'
  : Astro.url.pathname.replace(/\/$/, '') || '/'
const isActive = (href: string) => current === href || current.startsWith(`${href}/`)
---

<header class="nav" data-nav>
  <div class="container bar">
    <a href="/" class="brand" aria-label="nostream home"><Logo /></a>

    <nav class="links" aria-label="Primary">
      {
        NAV.map((item) => (
          <a href={item.href} class:list={['link', { active: isActive(item.href) }]}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="actions">
      <a class="version mono" href="/changelog">v{VERSION}</a>
      <a class:list={['btn btn-primary get-started', { self: isActive('/get-started') }]} href={isActive('/get-started') ? '#build' : '/get-started'}>Get started</a>
      <a class="gh" href={REPO} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"
          ><path
            fill="currentColor"
            d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8 0 3.2.9.8 1.3 1.9 1.3 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1 .9 2.2v3.3c0 .3.1.7.8.6A12 12 0 0 0 12 .3"
          ></path></svg
        >
        <span>GitHub</span>
      </a>
      <button class="menu" type="button" aria-label="Open menu" aria-expanded="false" data-menu>
        <span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="drawer" aria-label="Mobile" data-drawer>
    <a class="drawer-cta" href={isActive('/get-started') ? '#build' : '/get-started'}>Get started</a>
    {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
    <a href={REPO} target="_blank" rel="noopener noreferrer">GitHub</a>
  </nav>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')
  const menu = document.querySelector<HTMLButtonElement>('[data-menu]')

  const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 8)
  onScroll()
  window.addEventListener('scroll', onScroll, { passive: true })

  menu?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open') ?? false
    menu.setAttribute('aria-expanded', String(open))
    menu.setAttribute('aria-label', open ? 'Close menu' : 'Open menu')
  })

  // Same-page hash links from the mobile drawer (the Get-started CTA on
  // /get-started) scroll under the still-open drawer — close it first.
  document.querySelectorAll<HTMLAnchorElement>('.drawer a[href^="#"]').forEach((a) => {
    a.addEventListener('click', () => {
      nav?.classList.remove('open')
      menu?.setAttribute('aria-expanded', 'false')
      menu?.setAttribute('aria-label', 'Open menu')
    })
  })
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition:
      background 0.25s ease,
      border-color 0.25s ease;
  }

  .nav:global(.scrolled),
  .nav:global(.open) {
    border-color: var(--line);
    background: rgba(8, 8, 10, 0.82);
    backdrop-filter: blur(14px) saturate(140%);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 68px;
  }

  .links {
    display: none;
    gap: 6px;
  }

  .link {
    padding: 8px 14px;
    border-radius: 6px;
    color: var(--fg-2);
    font-family: var(--mono);
    font-size: 14px;
    transition:
      color 0.2s ease,
      background 0.2s ease;
  }

  .link:hover,
  .link.active {
    background: var(--panel);
    color: var(--fg);
  }

  .link.active {
    box-shadow: inset 0 -1px 0 var(--pink);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .version {
    display: none;
    color: var(--teal);
    font-size: 13px;
  }

  .get-started {
    display: none;
    height: 36px;
    padding: 0 16px;
    font-size: 13px;
  }

  /* On /get-started the CTA scrolls to the build block instead of linking
     to the page you are already on — keep it visible but quiet. */
  .get-started.self {
    border: 1px solid var(--panel-border);
    background: none;
    color: var(--fg-2);
  }

  .gh {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 14px;
    border: 1px solid var(--panel-border);
    border-radius: 7px;
    color: var(--fg);
    font-family: var(--mono);
    font-size: 13px;
    transition: border-color 0.2s ease;
  }

  .gh:hover {
    border-color: var(--wire);
  }

  .menu {
    display: grid;
    place-content: center;
    gap: 6px;
    width: 38px;
    height: 36px;
    border: 1px solid var(--panel-border);
    border-radius: 7px;
    background: none;
    cursor: pointer;
  }

  .menu span {
    width: 16px;
    height: 1.5px;
    background: var(--fg);
    transition: transform 0.2s ease;
  }

  .nav:global(.open) .menu span:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }

  .nav:global(.open) .menu span:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  .drawer {
    display: none;
    flex-direction: column;
    padding: 8px 24px 20px;
  }

  .nav:global(.open) .drawer {
    display: flex;
  }

  .drawer a {
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    color: var(--fg);
    font-family: var(--mono);
  }

  .drawer-cta {
    margin-bottom: 4px;
    padding: 14px 16px !important;
    border: 1px solid var(--pink) !important;
    border-radius: 8px;
    background: var(--pink);
    color: #fff !important;
    font-weight: 600;
    text-align: center;
  }

  @media (min-width: 760px) {
    .links,
    .version,
    .get-started {
      display: inline-flex;
    }
    .menu,
    .drawer,
    .nav:global(.open) .drawer {
      display: none;
    }
  }
</style>
