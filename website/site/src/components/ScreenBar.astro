---
import Logo from './Logo.astro'

interface Props {
  title: string
}
const { title } = Astro.props
---

<div class="screen-bar" aria-hidden="true">
  <span class="dot"></span><span class="dot"></span><span class="dot"></span>
  <Logo size={16} word={false} />
  <span class="title">{title}</span>
  <slot />
</div>
