---
import FilmFrame from '../FilmFrame.astro'
import { VERSION } from '../../data/site'
---

<section class="stage" data-spark-host data-spark-mode="stream">
  <h1 class="hero-h1">
    <span class="g1">Nostr runs on relays.</span>
    <span class="g2">nostream is the one you own.</span>
  </h1>
  <p class="hero-sub sr-only">
    A production-ready Nostr relay you deploy and control — self-hosted and open source.
  </p>
  <canvas
    class="spark-canvas"
    data-spark-canvas
    data-max-pool="2600"
    data-spawn-chance="0.995"
    data-per-frame="8"
    aria-hidden="true"></canvas>
  <FilmFrame
    class="hero-film"
    src={`${import.meta.env.BASE_URL}media/hero.mp4`.replace(/\/\//, '/')}
    lowSrc={`${import.meta.env.BASE_URL}media/hero-low.mp4`.replace(/\/\//, '/')}
    poster={`${import.meta.env.BASE_URL}media/hero-poster.webp`.replace(/\/\//, '/')}
    title={`/hero · nostream ${VERSION}`}
  />
  <button class="film-toggle mono" type="button" data-film-toggle aria-pressed="false" aria-label="Pause the hero film">Pause</button>
</section>

<style>
  .stage {
    --pad-y: clamp(18px, 3.5vh, 44px);
    --pad-x: clamp(14px, 3.5vw, 56px);
    --film-h: calc(100svh - 68px - 2 * var(--pad-y) - 36px);

    position: relative;
    z-index: 0;
    box-sizing: border-box;
    height: calc(100svh - 68px);
    min-height: 420px;
    overflow: hidden;
    background: var(--bg);
  }

  /* The headline used to live only inside the rendered film — invisible to
     search and screen readers. It is real text now, echoing the film's
     second scene; the film keeps telling the full story beside it. */
  .hero-h1 {
    position: absolute;
    z-index: 3;
    left: var(--pad-x);
    top: clamp(28px, 7vh, 72px);
    max-width: min(560px, calc(100% - 2 * var(--pad-x)));
    margin: 0;
    font-size: clamp(30px, 4.4vw, 54px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    pointer-events: none;
  }

  .hero-h1 span {
    display: block;
  }

  .hero-h1 .g2 {
    color: var(--pink);
  }

  .film-toggle {
    position: absolute;
    z-index: 4;
    left: var(--pad-x);
    bottom: clamp(18px, 3.5vh, 44px);
    padding: 8px 14px;
    border: 1px solid var(--panel-border);
    border-radius: 7px;
    background: rgba(14, 14, 17, 0.8);
    color: var(--fg-2);
    font-size: 12px;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .film-toggle:hover {
    border-color: var(--wire);
    color: var(--fg);
  }

  .spark-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .stage :global(.hero-film) {
    position: absolute;
    z-index: 2;
    top: 50%;
    right: var(--pad-x);
    transform: translateY(-50%);
    width: min(1320px, 86vw, calc(var(--film-h) * 16 / 9));
    max-width: calc(100% - 2 * var(--pad-x));
    max-height: calc(var(--film-h) + 36px);
  }

  .stage :global(.hero-film .film-crisp.screen) {
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.05),
      0 32px 90px -40px rgba(0, 0, 0, 0.95);
  }

  .stage :global(.hero-film .film-crisp video) {
    max-height: var(--film-h);
    object-fit: contain;
  }

  @media (max-width: 900px) {
    .stage {
      height: auto;
      min-height: 0;
      padding: var(--pad-y) var(--pad-x);
    }

    /* Headline becomes normal flow above the film; the pause control stays
       pinned to the stage's bottom-left. */
    .hero-h1 {
      position: static;
      max-width: none;
      margin-bottom: 18px;
      pointer-events: auto;
    }

    .film-toggle {
      position: static;
      margin-top: 14px;
    }

    .stage :global(.hero-film) {
      position: relative;
      top: auto;
      right: auto;
      transform: none;
      width: 100%;
      max-width: 100%;
      max-height: none;
    }

    .stage :global(.hero-film .film-crisp video) {
      max-height: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .spark-canvas {
      display: none;
    }
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  // The Base layout plays the film only while visible; this adds the manual
  // pause. Base's IntersectionObserver re-plays on scroll, so a deliberately
  // paused film is kept paused by intercepting the play event.
  let userPaused = false
  document.querySelector<HTMLButtonElement>('[data-film-toggle]')?.addEventListener('click', (e) => {
    const button = e.currentTarget as HTMLButtonElement
    const video = document.querySelector<HTMLVideoElement>('.hero-film video')
    if (!video) return
    userPaused = !video.paused
    if (video.paused) {
      void video.play()
      button.textContent = 'Pause'
      button.setAttribute('aria-pressed', 'false')
      button.setAttribute('aria-label', 'Pause the hero film')
    } else {
      video.pause()
      button.textContent = 'Play'
      button.setAttribute('aria-pressed', 'true')
      button.setAttribute('aria-label', 'Play the hero film')
    }
  })
  document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach((v) => {
    v.addEventListener('play', () => {
      if (userPaused) v.pause()
    })
  })
</script>
